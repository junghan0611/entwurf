{
	"schemaVersion": 1,
	"lane": "acp-cortex",
	"mutants": [
		{
			"claim": "CLAUDE-CURATED-ROWS",
			"title": "dropping a curated Claude row shrinks the operator's model list",
			"subject": "pi-extensions/lib/acp/model-ids.js",
			"find": [
				"export const SUPPORTED_ANTHROPIC_MODEL_IDS = /** @type {const} */ ([",
				"\t\"claude-sonnet-5-5\",",
				"\t\"claude-opus-5-5\",",
				"\t\"claude-fable-5-2\",",
				"]);"
			],
			"replace": [
				"export const SUPPORTED_ANTHROPIC_MODEL_IDS = /** @type {const} */ ([",
				"\t\"claude-sonnet-5-5\",",
				"\t\"claude-opus-5-5\",",
				"]);"
			],
			"gate": ["bash", "run.sh", "check-acp-provider-surface"],
			"timeoutSeconds": 300,
			"signature": "[QK:CLAUDE-CURATED-ROWS]",
			"signatureSource": "scripts/check-acp-provider-surface.ts"
		},
		{
			"claim": "ACP-OVERLAY-SESSIONKEY-WIRED",
			"title": "passing a cwd-derived key instead of resolveSessionKey's value merges distinct sessions' overlay scopes",
			"subject": "pi-extensions/lib/acp/backend.ts",
			"find": [
				"\t\t\toverlay = adapter.ensureOverlay({",
				"\t\t\t\tcwd,",
				"\t\t\t\tmodelId: model.id,",
				"\t\t\t\tnativeModelId,",
				"\t\t\t\tconfig,",
				"\t\t\t\tsessionKey,",
				"\t\t\t\tsummaryTurn: Boolean(summary),",
				"\t\t\t});"
			],
			"replace": [
				"\t\t\toverlay = adapter.ensureOverlay({",
				"\t\t\t\tcwd,",
				"\t\t\t\tmodelId: model.id,",
				"\t\t\t\tnativeModelId,",
				"\t\t\t\tconfig,",
				"\t\t\t\tsessionKey: `cwd:${cwd}`,",
				"\t\t\t\tsummaryTurn: Boolean(summary),",
				"\t\t\t});"
			],
			"gate": ["bash", "run.sh", "check-acp-session-reuse"],
			"timeoutSeconds": 300,
			"signature": "[QK:ACP-OVERLAY-SESSIONKEY-WIRED]",
			"signatureSource": "scripts/check-acp-session-reuse.ts"
		},
		{
			"claim": "ACP-PROVIDER-CLAUDE-ONLY",
			"title": "the provider entry advertises a retired Cortex row despite the admission fence",
			"subject": "pi-extensions/acp-provider.ts",
			"find": ["\t\tmodels: allCuratedModels(),"],
			"replace": ["\t\tmodels: [...allCuratedModels(), { ...allCuratedModels()[0], id: \"cortex-auto\" }],"],
			"gate": ["bash", "run.sh", "check-acp-provider-surface"],
			"timeoutSeconds": 300,
			"signature": "[QK:ACP-PROVIDER-CLAUDE-ONLY]",
			"signatureSource": "scripts/check-acp-provider-surface.ts"
		}
	]
}
