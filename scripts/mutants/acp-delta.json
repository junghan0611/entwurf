{
	"schemaVersion": 1,
	"lane": "acp-delta",
	"mutants": [
		{
			"claim": "ACP-DELTA-STEER-ALL",
			"title": "only the first queued steer is sent",
			"subject": "pi-extensions/lib/acp/backend.ts",
			"find": ["\t\t\t\t\tprompt: sent.flatMap((input) => input.blocks),"],
			"replace": ["\t\t\t\t\tprompt: sent.slice(0, 1).flatMap((input) => input.blocks),"],
			"gate": ["bash", "run.sh", "check-acp-set-model-readback"],
			"timeoutSeconds": 300,
			"signature": "[QK:ACP-DELTA-STEER-ALL]",
			"signatureSource": "pi-extensions/lib/acp/backend.thinking.test.ts"
		},
		{
			"claim": "ACP-DELTA-FOLLOWUP-ALL",
			"title": "the queued follow-up sequence is reversed",
			"subject": "pi-extensions/lib/acp/backend.ts",
			"find": ["\t\t\t\t\tprompt: sent.flatMap((input) => input.blocks),"],
			"replace": ["\t\t\t\t\tprompt: [...sent].reverse().flatMap((input) => input.blocks),"],
			"gate": ["bash", "run.sh", "check-acp-set-model-readback"],
			"timeoutSeconds": 300,
			"signature": "[QK:ACP-DELTA-FOLLOWUP-ALL]",
			"signatureSource": "pi-extensions/lib/acp/backend.thinking.test.ts"
		},
		{
			"claim": "ACP-DELTA-BASH-NEXT",
			"title": "the first projected user block is dropped before the prompt",
			"subject": "pi-extensions/lib/acp/backend.ts",
			"find": ["\t\t\t\t\tprompt: sent.flatMap((input) => input.blocks),"],
			"replace": ["\t\t\t\t\tprompt: sent.slice(1).flatMap((input) => input.blocks),"],
			"gate": ["bash", "run.sh", "check-acp-set-model-readback"],
			"timeoutSeconds": 300,
			"signature": "[QK:ACP-DELTA-BASH-NEXT]",
			"signatureSource": "pi-extensions/lib/acp/backend.thinking.test.ts"
		},
		{
			"claim": "ACP-DELTA-MAX-TOKENS",
			"title": "the resident ignores an exact omission when no new compaction follows it",
			"subject": "pi-extensions/lib/acp/backend.ts",
			"find": ["const walk = omission?.walk ?? walkDelta(anchor, branch);"],
			"replace": ["const walk = omission?.walk.compacted ? omission.walk : walkDelta(anchor, branch);"],
			"gate": ["bash", "run.sh", "check-acp-set-model-readback"],
			"timeoutSeconds": 300,
			"signature": "[QK:ACP-DELTA-MAX-TOKENS]",
			"signatureSource": "pi-extensions/lib/acp/backend.thinking.test.ts"
		},
		{
			"claim": "ACP-COMPACT-FIRST-USER-BLOCK",
			"title": "compaction attribution looks at the last delta block instead of the first",
			"subject": "pi-extensions/lib/acp/backend.ts",
			"find": ["isCompactCommand(delta[0]?.text)"],
			"replace": ["isCompactCommand(delta[delta.length - 1]?.text)"],
			"gate": ["bash", "run.sh", "check-acp-compaction"],
			"timeoutSeconds": 300,
			"signature": "[QK:ACP-COMPACT-FIRST-USER-BLOCK]",
			"signatureSource": "pi-extensions/lib/acp/backend.compaction.test.ts"
		}
	]
}
