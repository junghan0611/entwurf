#!/usr/bin/env sh
# entwurf pre-commit — fast static safety only, never the full floor.
#
# The full `pnpm check` floor is owned by the work protocol: it runs once on
# the frozen commit candidate before the commit is cut (AGENTS.md
# "Verification scheduling"). This hook keeps only checks too cheap to
# dominate a commit. Do not grow it back.
#
# Bypass with `git commit --no-verify` only when you genuinely understand
# why the gate complained — the typical answer is "fix the underlying
# issue, not the hook".

set -e

git diff --cached --check
pnpm lint
pnpm typecheck
